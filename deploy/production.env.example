# Production. Copy to .env on the server: `cp deploy/production.env.example .env`.
# Secrets are NOT set here: run deploy/generate-secrets.sh. See docs/deployment.md.
COMPOSE_FILE=compose.yaml:compose.prod.yaml

# Public DNS name pointing at this host, and the contact address for Let's Encrypt.
SHARELLM_DOMAIN=sharellm.example.org
ACME_EMAIL=ops@example.org

# Image to run. Leave the default to build on this host, or set a tag from your registry.
# SHARELLM_IMAGE=registry.example.org/sharellm-server:0.1.0

# External PostgreSQL (optional; the bundled postgres service is used by default).
# SHARELLM_DATABASE_URL=jdbc:postgresql://db.internal:5432/sharellm?sslmode=verify-full
# SHARELLM_DATABASE_USER=sharellm

# Queue behaviour (defaults shown).
# REQUEST_WAIT_SECONDS=300
# UPSTREAM_RESPONSE_TIMEOUT=330s   # must exceed REQUEST_WAIT_SECONDS
# HEARTBEAT_TIMEOUT_SECONDS=35
# LEASE_SECONDS=45
# MAX_ATTEMPTS=3
# WORKER_POLL_SECONDS=15
# RESULT_RETENTION_HOURS=24
# QUEUE_LIMIT=0
# MAX_BODY_BYTES=1048576
# MAX_REQUEST_BODY=2MB             # proxy limit; keep above MAX_BODY_BYTES

# Resources.
# SHARELLM_MEMORY_LIMIT=1g
# SHARELLM_CPU_LIMIT=2
# POSTGRES_MEMORY_LIMIT=1g
# DB_POOL_SIZE=24
