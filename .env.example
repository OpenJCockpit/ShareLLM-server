# Local development. Copy to .env: `cp .env.example .env`. See docs/development.md.
COMPOSE_FILE=compose.yaml:compose.dev.yaml

# Development-only secrets; use different values for owners and workers.
SHARELLM_PUBLIC_KEYS=dev-owner-key
SHARELLM_WORKER_KEY=dev-worker-key
DATABASE_PASSWORD=sharellm

# Host ports (bound to 127.0.0.1). Change them if they are taken on your machine.
SHARELLM_HTTP_PORT=8080
SHARELLM_MANAGEMENT_HOST_PORT=8081
POSTGRES_HOST_PORT=5432

# Optional tuning (defaults shown).
# REQUEST_WAIT_SECONDS=300
# HEARTBEAT_TIMEOUT_SECONDS=35
# LEASE_SECONDS=45
# MAX_ATTEMPTS=3
